#!/usr/bin/env bash
# Prepare exact safety-checked products with Nix, then run the complete suite.
set -u
project=$(cd "$(dirname "$0")" && pwd -P) || exit 1
cd "$project" || exit 1
command -v nix >/dev/null || { echo 'Nix is required to prepare tests' >&2; exit 69; }
scratch=$(mktemp -d "${RARZ_TEST_TMPDIR:-/var/tmp}/rarz-tests.XXXXXXXX") || exit 1
status=1
finish() {
	if [[ -f $scratch/memory-peak.bytes ]]; then printf 'Runtime cgroup peak bytes: %s\n' "$(cat "$scratch/memory-peak.bytes")"; fi
	printf 'Test evidence retained at %s\n' "$scratch" >&2
}
trap finish EXIT
printf 'Preparing ReleaseSafe test products through Nix\n'
nix build .#test-artifacts --out-link "$scratch/product" || exit 1
product=$(readlink -f "$scratch/product") || exit 1
system=$(nix eval --impure --raw --expr builtins.currentSystem) || exit 1
smoke_failed=0
nix build --no-link ".#checks.$system.package-smoke" || smoke_failed=1
nix build --no-link ".#checks.$system.build-publication" || smoke_failed=1
if [[ $system == x86_64-linux ]]; then
	nix build --no-link ".#checks.$system.windows-metadata" || smoke_failed=1
fi
runtime=(nix develop -c bash tests/support/run-suite "$product" "$project" "$scratch")
if command -v build-budget >/dev/null && ! [[ $(cat /proc/self/cgroup 2>/dev/null) == *agentbuilds.slice* ]]; then
	build-budget --project rarz -- "${runtime[@]}"
	status=$?
else
	"${runtime[@]}"
	status=$?
fi
if [[ $status == 0 && $smoke_failed == 1 ]]; then status=1; fi
exit "$status"

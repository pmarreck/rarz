#!/usr/bin/env bash
set -euo pipefail

errors=0

echo "=== Zig unit tests ==="
if ! nix develop -c zig build test; then
    ((errors += 1))
fi

if [ -d tests/cli ]; then
    echo "=== Build CLI for CLI tests ==="
    if ! nix develop -c zig build; then
        ((errors += 1))
    fi

    echo "=== CLI tests ==="
    for t in tests/cli/test_*.sh; do
        [ -f "$t" ] || continue
        echo "  running $t"
        if ! bash "$t"; then
            ((errors += 1))
        fi
    done
fi

if [ "$errors" -gt 0 ]; then
    echo "FAILED: $errors test suite(s)"
    exit "$errors"
fi

echo "ALL TESTS PASSED"
